        <mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1F3864;strokeWidth=2;fontColor=#1F3864;fontSize=11;dashed=0;endArrow=blockThin;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n9" target="n10">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e22" value="candidato a memoria" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1B5E20;strokeWidth=2;fontColor=#1B5E20;fontSize=11;dashed=0;endArrow=blockThin;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n8" target="n11">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1B5E20;strokeWidth=2;fontColor=#1B5E20;fontSize=11;dashed=0;endArrow=blockThin;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n11" target="n12">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1B5E20;strokeWidth=2;fontColor=#1B5E20;fontSize=11;dashed=0;endArrow=blockThin;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n12" target="n13">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1B5E20;strokeWidth=2;fontColor=#1B5E20;fontSize=11;dashed=0;endArrow=blockThin;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n13" target="n14">
          <mxGeometry relative="1" as="geometry">
          </mxGeometry>
        </mxCell>
        <mxCell id="e26" value="C1 filtra LOS DOS canales — perfil fijado y similitud —&#10;y solo entrega lo del namespace del usuario y no caducado" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1B5E20;strokeWidth=2;fontColor=#1B5E20;fontSize=11;dashed=0;endArrow=blockThin;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="n13" target="n8">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1055" y="440" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="n27" value="Que cambia respecto de la arquitectura Unsecure" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#1B5E20;fontSize=16;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="855" width="800" height="26" as="geometry" />
        </mxCell>
        <mxCell id="n28" value="&lt;b&gt;&lt;font color='#1B5E20'&gt;C1 Aislamiento.&lt;/font&gt;&lt;/b&gt; Particion por (tenant_id, user_id) con filtro obligatorio &lt;b&gt;en los dos canales de recuperacion&lt;/b&gt; y cifrado por tenant → suprime el canal de fuga entre conversaciones y usuarios. Cubre ②." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#1F3864;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="890" width="1560" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n29" value="&lt;b&gt;&lt;font color='#1B5E20'&gt;C2 Segregacion datos/instrucciones.&lt;/font&gt;&lt;/b&gt; La memoria pierde la autoridad del rol system y pasa a leerse como dato inerte → neutraliza la instruccion latente. Cubre ③." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#1F3864;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="940" width="1560" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n30" value="&lt;b&gt;&lt;font color='#1B5E20'&gt;C3 Write-Gate + tipado.&lt;/font&gt;&lt;/b&gt; Impide que una instruccion llegue siquiera a persistirse; el esquema tipado elimina el texto libre como vehiculo. Cubre ①." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#1F3864;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="990" width="1560" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n31" value="&lt;b&gt;&lt;font color='#1B5E20'&gt;C4 Procedencia firmada.&lt;/font&gt;&lt;/b&gt; Cada registro lleva autor, sesion de origen y HMAC; lo no firmado o alterado se descarta en la lectura. Cubre ① y ④." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#1F3864;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="1040" width="1560" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n32" value="&lt;b&gt;&lt;font color='#1B5E20'&gt;C5 Ciclo de vida.&lt;/font&gt;&lt;/b&gt; TTL por categoria y borrado verificable en las tres capas acotan la ventana de persistencia y hacen real el &quot;olvidalo&quot;. Cubre ④." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#1F3864;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="1090" width="1560" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n33" value="&lt;b&gt;&lt;font color='#1B5E20'&gt;C6 Autorizacion por origen + auditoria.&lt;/font&gt;&lt;/b&gt; Contiene el impacto sobre las herramientas y aporta la evidencia reproducible de cada prueba. Cubre ⑤." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#1F3864;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="1140" width="1560" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n34" value="Criterio de aprobacion de C1: M2a = 0 (fuga de recuperacion). No basta con M2b = 0: que el modelo no repita un dato ajeno que el indice ya le entrego no es un control, es suerte." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#1B5E20;fontSize=14;align=left;verticalAlign=top;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="1196" width="1560" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
