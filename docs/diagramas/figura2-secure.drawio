<mxfile host="app.diagrams.net" type="device">
  <diagram name="Figura 2 - Arquitectura Secure" id="Figura 2 - Arquitectura Secure">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1340" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n1" value="Figura 2. Arquitectura Secure" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#1B5E20;fontSize=20;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="La misma solución. En verde, los controles C1–C6 y el nuevo límite de confianza, que deja por fuera el contenido recuperado de la memoria." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#6B7A90;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="1200" height="24" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="Zona de confianza del sistema — el contenido recuperado de memoria NO forma parte de ella" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=none;dashed=1;dashPattern=8 6;strokeColor=#6B7A90;strokeWidth=2;fontColor=#6B7A90;fontSize=15;verticalAlign=top;align=center;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="100" width="1300" height="810" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;Usuario A&lt;/b&gt;&lt;br&gt;tenant T1 · user A" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE3F3;strokeColor=#2F5597;strokeWidth=2;fontColor=#1F3864;fontSize=17;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="175" width="210" height="66" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;Usuario B&lt;/b&gt;&lt;br&gt;tenant T1 · user B" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FBE4E4;strokeColor=#C00000;strokeWidth=2;fontColor=#B00020;fontSize=17;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="275" width="210" height="66" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;C1 · Identidad&lt;/b&gt;&lt;br&gt;&lt;br&gt;tenant_id + user_id +&lt;br&gt;session_id firmados (JWT);&lt;br&gt;toda escritura y lectura los exigen" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=2;fontColor=#1B5E20;fontSize=17;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="385" width="240" height="170" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;Interfaz de chat&lt;/b&gt;&lt;br&gt;(Streamlit)&lt;br&gt;&lt;br&gt;propaga el token&lt;br&gt;con los claims" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F3864;strokeWidth=2;fontColor=#1F3864;fontSize=17;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="340" y="210" width="200" height="140" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="&lt;b&gt;Orquestador (FastAPI)&lt;/b&gt;&lt;br&gt;&lt;b&gt;C2 · Context Builder&lt;/b&gt;&lt;br&gt;&lt;br&gt;la memoria se inyecta como&lt;br&gt;DATOS delimitados dentro de&lt;br&gt;&amp;lt;memoria_no_ejecutable&amp;gt;&lt;br&gt;nunca en el rol system&lt;br&gt;&lt;br&gt;+ spotlighting y regla explícita&lt;br&gt;de no obedecer lo recuperado" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=2;fontColor=#1B5E20;fontSize=17;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="600" y="150" width="320" height="260" as="geometry" />
        </mxCell>
        <mxCell id="n9" value="&lt;b&gt;LLM local&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ollama ·&lt;br&gt;Llama 3.1 8B" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F3864;strokeWidth=2;fontColor=#1F3864;fontSize=17;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="950" y="220" width="170" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n10" value="&lt;b&gt;Herramientas / APIs&lt;/b&gt;&lt;br&gt;&lt;b&gt;C6 · Autorización por origen&lt;/b&gt;&lt;br&gt;&lt;br&gt;toda acción cuya justificación&lt;br&gt;provenga de memoria exige&lt;br&gt;confirmación explícita del usuario&lt;br&gt;&lt;br&gt;buscar_doc() · enviar_correo()" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=2;fontColor=#1B5E20;fontSize=17;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1170" y="170" width="320" height="220" as="geometry" />
        </mxCell>
        <mxCell id="n11" value="&lt;b&gt;C3 · Write-Gate&lt;/b&gt;&lt;br&gt;&lt;br&gt;clasificador en dos etapas&lt;br&gt;(reglas + LLM juez) que bloquea&lt;br&gt;imperativos, secretos y PII&lt;br&gt;&lt;br&gt;solo pasan hechos tipados&lt;br&gt;(esquema Pydantic)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=2;fontColor=#1B5E20;fontSize=17;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="350" y="520" width="270" height="240" as="geometry" />
        </mxCell>
        <mxCell id="n12" value="&lt;b&gt;Memory Manager&lt;/b&gt;&lt;br&gt;&lt;b&gt;C4 · Procedencia&lt;/b&gt;&lt;br&gt;&lt;br&gt;origin_session, autor,&lt;br&gt;timestamp y HMAC por&lt;br&gt;registro; sin firma → descarte" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=2;fontColor=#1B5E20;fontSize=17;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="650" y="540" width="250" height="200" as="geometry" />
        </mxCell>
        <mxCell id="n13" value="&lt;b&gt;Almacén de memoria&lt;/b&gt;&lt;br&gt;&lt;b&gt;C1 · Aislamiento&lt;/b&gt;&lt;br&gt;&lt;br&gt;ChromaDB: espacio de nombres por&lt;br&gt;(tenant_id, user_id)&lt;br&gt;+ filtro de metadatos obligatorio&lt;br&gt;&lt;br&gt;SQLite cifrado con clave por tenant&lt;br&gt;C5 · TTL por categoría de dato" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=2;fontColor=#1B5E20;fontSize=17;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="930" y="520" width="360" height="240" as="geometry" />
        </mxCell>
        <mxCell id="n14" value="&lt;b&gt;C5 · Ciclo de vida&lt;/b&gt;&lt;br&gt;&lt;br&gt;expiración perezosa en la lectura + job de purga&lt;br&gt;&lt;br&gt;borrado verificable en las tres capas: fila, embedding y caché&lt;br&gt;&lt;br&gt;emite prueba de borrado (HMAC)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=2;fontColor=#1B5E20;fontSize=17;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1320" y="520" width="250" height="240" as="geometry" />
        </mxCell>
        <mxCell id="n15" value="&lt;b&gt;C6 · Observabilidad y auditoría&lt;/b&gt;&lt;br&gt;&lt;br&gt;registro append-only de cada escritura y cada recuperación de memoria (quién, cuándo, qué namespace, veredicto del write-gate),&lt;br&gt;trazas OpenTelemetry por turno y alerta ante tasa anómala de escrituras o de bloqueos" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#1B5E20;strokeWidth=2;fontColor=#1B5E20;fontSize=17;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="350" y="785" width="1220" height="100" as="geometry" />
        </mxCell>
