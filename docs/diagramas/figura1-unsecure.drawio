        <mxCell id="n8" value="&lt;b&gt;LLM local&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ollama ·&lt;br&gt;Llama 3.1 8B" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F3864;strokeWidth=2;fontColor=#1F3864;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
