        <mxCell id="n2" value="Componentes, flujo de datos y el único límite de confianza. En rojo, las debilidades que el experimento explota." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#6B7A90;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1">
