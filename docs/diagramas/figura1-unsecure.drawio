        </mxCell>
        <mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B00020;strokeWidth=2;fontColor=#B00020;fontSize=14;dashed=1;endArrow=blockThin;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.102;exitY=0;exitDx=0;exitDy=0;entryX=0.6538;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n11" target="n7">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1000" y="550" />
              <mxPoint x="780" y="550" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="n21" value="escribe &quot;hechos&quot;" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#1F3864;fontSize=15;align=right;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="490" y="520" width="150" height="22" as="geometry" />
        </mxCell>
        <mxCell id="n22" value="&lt;b&gt;CANAL 1 · perfil fijado&lt;/b&gt;&lt;br&gt;entra en TODAS las sesiones,&lt;br&gt;sin pasar por la búsqueda ② → T01" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#B00020;fontSize=15;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1115" y="488" width="330" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n23" value="&lt;b&gt;CANAL 2 · similitud&lt;/b&gt;&lt;br&gt;top-k sin filtro de&lt;br&gt;propietario ② → T02" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#B00020;fontSize=15;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="792" y="560" width="196" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n24" value="Debilidades presentes en esta arquitectura" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#B00020;fontSize=16;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="910" width="700" height="26" as="geometry" />
        </mxCell>
        <mxCell id="n25" value="&lt;b&gt;①  Escritura sin validación:&lt;/b&gt; cualquier frase imperativa del turno se persiste como hecho del usuario. El sistema nunca se pregunta si el texto es un dato o una orden." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#1F3864;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="946" width="1560" height="40" as="geometry" />
        </mxCell>
        <mxCell id="n26" value="&lt;b&gt;②  Recuperación sin aislamiento:&lt;/b&gt; NINGUNO de los dos canales filtra por tenant, usuario ni sesión. La memoria es de facto compartida, y el perfil fijado además entra sin importar la pregunta." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#1F3864;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="990" width="1560" height="40" as="geometry" />
        </mxCell>
        <mxCell id="n27" value="&lt;b&gt;③  Confusión datos ↔ instrucciones:&lt;/b&gt; lo recuperado se concatena dentro del bloque de sistema, con la misma autoridad que las reglas del operador." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#1F3864;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="1034" width="1560" height="40" as="geometry" />
        </mxCell>
        <mxCell id="n28" value="&lt;b&gt;④  Sin ciclo de vida:&lt;/b&gt; no hay TTL, ni firma de procedencia, ni borrado verificable; el embedding sobrevive al borrado de la fila en SQLite." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#1F3864;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="1078" width="1560" height="40" as="geometry" />
        </mxCell>
        <mxCell id="n29" value="&lt;b&gt;⑤  Sin observabilidad:&lt;/b&gt; no existe registro de qué se escribió en memoria, quién lo escribió ni qué se recuperó en cada sesión." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#1F3864;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="1122" width="1560" height="40" as="geometry" />
        </mxCell>
        <mxCell id="n30" value="Consecuencia: el atacante no necesita mantener la sesión abierta — deja el payload y este se ejecuta solo en la siguiente conversación de la víctima." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#B00020;fontSize=14;align=left;verticalAlign=top;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="1172" width="1560" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
