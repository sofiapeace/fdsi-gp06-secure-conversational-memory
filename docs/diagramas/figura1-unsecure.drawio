        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;Orquestador (FastAPI)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Prompt final =&lt;br&gt;[ system ] +&lt;br&gt;&lt;b&gt;&lt;font color='#B00020'&gt;[ memoria recuperada&lt;br&gt;COMO instrucciones ]&lt;/font&gt;&lt;/b&gt;&lt;br&gt;+ [ turno del usuario ]&lt;br&gt;&lt;br&gt;&lt;font color='#B00020'&gt;&lt;b&gt;③&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F3864;strokeWidth=2;fontColor=#1F3864;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
