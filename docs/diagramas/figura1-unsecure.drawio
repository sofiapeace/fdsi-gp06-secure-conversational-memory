        </mxCell>
        <mxCell id="e19" value="CANAL 1 · perfil fijado: entra en TODAS las sesiones,  sin pasar por la busqueda  ②   ⟶  explota T01" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B00020;strokeWidth=2;fontColor=#B00020;fontSize=11;dashed=1;endArrow=blockThin;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.2;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.82;entryDx=0;entryDy=0;" edge="1" parent="1" source="n11" target="n7">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1048" y="455" />
              <mxPoint x="895" y="455" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e20" value="CANAL 2 · top-k por similitud, SIN filtro de propietario  ②   ⟶  explota T02" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B00020;strokeWidth=2;fontColor=#B00020;fontSize=11;dashed=1;endArrow=blockThin;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.35;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n11" target="n7">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="905" y="650" />
              <mxPoint x="905" y="530" />
              <mxPoint x="790" y="530" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="n21" value="Debilidades presentes en esta arquitectura" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#B00020;fontSize=16;align=left;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="845" width="700" height="26" as="geometry" />
        </mxCell>
        <mxCell id="n22" value="&lt;b&gt;①  Escritura sin validacion:&lt;/b&gt; cualquier frase imperativa del turno se persiste como hecho del usuario. El sistema nunca se pregunta si el texto es un dato o una orden." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#1F3864;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="881" width="1560" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n23" value="&lt;b&gt;②  Recuperacion sin aislamiento:&lt;/b&gt; NINGUNO de los dos canales filtra por tenant, usuario ni sesion. La memoria es de facto compartida, y el perfil fijado ademas entra sin importar la pregunta." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#1F3864;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="931" width="1560" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n24" value="&lt;b&gt;③  Confusion datos ↔ instrucciones:&lt;/b&gt; lo recuperado se concatena dentro del bloque de sistema, con la misma autoridad que las reglas del operador." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#1F3864;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="981" width="1560" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n25" value="&lt;b&gt;④  Sin ciclo de vida:&lt;/b&gt; no hay TTL, ni firma de procedencia, ni borrado verificable; el embedding sobrevive al borrado de la fila en SQLite." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#1F3864;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="1031" width="1560" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n26" value="&lt;b&gt;⑤  Sin observabilidad:&lt;/b&gt; no existe registro de que se escribio en memoria, quien lo escribio ni que se recupero en cada sesion." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#1F3864;fontSize=13;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="1081" width="1560" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n27" value="Consecuencia: el atacante no necesita mantener la sesion abierta — deja el payload y este se ejecuta solo en la siguiente conversacion de la victima." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;fontColor=#B00020;fontSize=14;align=left;verticalAlign=top;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="1137" width="1560" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
