        <mxCell id="n9" value="&lt;b&gt;Herramientas / APIs&lt;/b&gt;&lt;br&gt;&lt;br&gt;buscar_doc()&lt;br&gt;enviar_correo() (simulada)&lt;br&gt;&lt;br&gt;&lt;font color='#B00020'&gt;se invocan sin verificar&lt;br&gt;el origen de la orden&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F3864;strokeWidth=2;fontColor=#1F3864;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1170" y="205" width="270" height="170" as="geometry" />
        </mxCell>
        <mxCell id="n10" value="&lt;b&gt;Memory Manager&lt;/b&gt;&lt;br&gt;&lt;br&gt;persiste texto libre del turno&lt;br&gt;&lt;font color='#B00020'&gt;tal cual, sin validacion &lt;b&gt;①&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F3864;strokeWidth=2;fontColor=#1F3864;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="400" y="600" width="260" height="140" as="geometry" />
        </mxCell>
        <mxCell id="n11" value="&lt;b&gt;Almacen de memoria&lt;/b&gt;&lt;br&gt;&lt;br&gt;ChromaDB — coleccion UNICA global&lt;br&gt;&lt;font color='#B00020'&gt;sin tenant_id / user_id / procedencia &lt;b&gt;②&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;SQLite — historial y hechos, borrado logico&lt;br&gt;&lt;font color='#B00020'&gt;sin TTL · sin firma · sin auditoria &lt;b&gt;④&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F3864;strokeWidth=2;fontColor=#1F3864;fontSize=13;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
